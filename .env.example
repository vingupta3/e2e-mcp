# ==============================================================================
# E2E Networks Cloud & TIR MCP Server Configuration
# ==============================================================================

# Your E2E Networks API Key (Generated from MyAccount -> Security / API Tokens)
E2E_API_KEY=your_api_key_here

# Your E2E Networks Auth/Bearer Token
E2E_AUTH_TOKEN=your_auth_token_here

# Default Project ID (optional: if omitted, operations apply to your default account project)
E2E_PROJECT_ID=

# Default Region / Location (default: DEL-1)
E2E_LOCATION=DEL-1

# Base URL for E2E Cloud MyAccount REST API
E2E_MYACCOUNT_BASE_URL=https://api.e2enetworks.com/myaccount

# Base URL for E2E TIR AI/ML Platform REST API
E2E_TIR_BASE_URL=https://api.e2enetworks.com/myaccount/api/v1/gpu

# HTTP/SSE Port when running in hosted mode (--http)
PORT=3000
HOST=0.0.0.0
